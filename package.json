{
  "name": "ulnar-rpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,html,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "24.x"
  }
}
