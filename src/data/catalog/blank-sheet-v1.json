        {
          "tier": 1,
          "description": "Vous maitrisez une potion de tier 2 maximum. Vous la fabriquez à moitié prix."
        },
        {
          "tier": 2,
          "description": "Vous pouvez résister à un jet de poison ou un effet droguant sur un jet de métier."
        },
        {
          "tier": 3,
          "description": "Vous pouvez faire un jet de métier sans malus pour reconnaitre à l'odeur les ingrédients d'une potion."
        },
        {
          "tier": 4,
          "description": "PotiVous maitrisez une potion de tier 5 maximum. Vous la fabriquez à moitié prix."
        },
        {
          "tier": 5,
          "description": "Quand vous faites un jet pour consommer ou faire consommer une potion, vous pouvez le faire sur un jet de métier."
        }
