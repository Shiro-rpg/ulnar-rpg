    {
      "id": "forgeron",
      "name": "Forgeron",
      "skills": [
        {
          "tier": 1,
          "description": "Vous disposez du matériel de réparation pour réparer autant de pièce d'équipements (casque, buste, bouclier, gants ou bottes) que votre niveau de forgeron. Nécessite une heure et se recharge en ville."
        },
        {
          "tier": 2,
          "description": "Vous pouvez utiliser un jet de métier au lieu d'un jet de savoir pour étudier une arme, une armure ou une forge."
        },
        {
          "tier": 3,
          "description": "Vous pouvez reconnaitre à l'oeil le palier de force d'une arme ou d'une armure sans jet."
        },
        {
          "tier": 4,
          "description": "Vous maitrisez un attribut de votre choix parfaitement et vous le fabriquez à moitié prix."
        },
        {
          "tier": 5,
          "description": "Vous disposez du matériel de réparation pour réparer jusqu'à 2x votre niveau de forgeron en pièce d'équipements au lieu de x1. Nécessite une heure et se recharge en ville."
        }
      ],
      "sourceRange": "A67:F67"
    },
    {
      "id": "alchimiste",
